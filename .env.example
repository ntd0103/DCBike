# Environment variables
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=dc_car_booking
JWT_SECRET=dc_car_booking_secret_key_2024
PORT=3000

# Payment / QR settings (for VNPAYQR)
# GUI usually 'VNPAYQR' for VNPAY aggregator
PAYMENT_VNQR_GUI=VNPAYQR
# Merchant id or receiving account used by VNPAY (subfield 01)
PAYMENT_VNPAY_MERCHANT_ID=your_merchant_id_or_account
# Optional biller/store id (subfield 02)
PAYMENT_VNPAY_BILLER_ID=
# Display name and city used in QR (optional)
PAYMENT_MERCHANT_NAME=DC Car Booking
PAYMENT_MERCHANT_CITY=HCMC

# Upload settings
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads